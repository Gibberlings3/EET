//FATESP.DLG
@1000000 = ~Portami Ajantis, il paladino.~
@1000001 = ~Portami Alora, la ladra halfling.~
@1000002 = ~Portami Baeloth, lo stregone drow.~
@1000003 = ~Portami Branwen, la chierica.~
@1000004 = ~Portami Coran, il guerriero ladro elfo.~
@1000005 = ~Portami Dynaheir, l'invocatrice.~
@1000006 = ~Portami Eldoth, il bardo.~
@1000007 = ~Portami Faldorn, la druida.~
@1000008 = ~Portami Garrick, il bardo.~
@1000009 = ~Portami Kagain, il nano guerriero.~
@1000010 = ~Portami Khalid, il guerriero mezzelfo.~
@1000011 = ~Portami Kivan, il ranger elfo.~
@1000012 = ~Portami Montaron, il guerriero ladro halfling.~
@1000013 = ~Portami Quayle, lo gnomo chierico illusionista.~
@1000014 = ~Portami Safana, la ladra.~
@1000015 = ~Portami Shar-Teel, la guerriera.~
@1000016 = ~Portami Skie, la ladra.~
@1000017 = ~Portami Tiax, lo gnomo chierico ladro.~
@1000018 = ~Portami Xan, l'incantatore elfo.~
@1000019 = ~Portami Xzar, il necromante.~
@1000020 = ~Portami Yeslick, il nano guerriero chierico.~
@1000021 = ~Portami Corwin, la ranger.~
@1000022 = ~Portami Glint, lo gnomo chierico ladro.~
@1000023 = ~Portami M'Khiin, la sciamana goblin.~
@1000024 = ~Portami Voghiln, lo skald.~

//based on BG2EE @73956; protagonist M/F variants preserved, target wording kept gender-neutral
@1000030 = ~Non posso fare come chiedi, Figlio di Bhaal. La persona che cerchi è morta e perciò per sempre al di fuori della mia portata. Il suo filo non si intreccia più con il tuo.~ ~Non posso fare come chiedi, Figlia di Bhaal. La persona che cerchi è morta e perciò per sempre al di fuori della mia portata. Il suo filo non si intreccia più con il tuo.~

//BDSCHAEL.DLG
//first part of SoD @40871
@1000040 = ~C'è un bardo chiamato Garrick e un paio di buoni a nulla chiamati Safana e Coran. Sono alla Taverna del Canto Elfico.~
//second part of SoD @40871
@1000041 = ~La strega Dynaheir e la sua guardia del corpo Minsc stanno ai Tre Vecchi Barili...~
//first part of SoD @40872
@1000042 = ~... Un monaco di nome Rasaad sta attualmente lavorando presso l'edificio del Trono di Ferro... Il Consiglio l'ha reso un rifugio per coloro che stanno fuggendo da Caelar.~
//second part of SoD @40872
@1000043 = ~E abbiamo preso un tale chiamato Tiax, rinchiuso al quartier generale del Pugno Fiammante.~
//based on SoD @60957
@1000044 = ~Dimmelo tu. Dobbiamo acquistare equipaggiamento e trovare alleati per il viaggio a nord. C'è una coppia di avventurieri Rashemi con cui possiamo parlare ai Tre Vecchi Barili, quel bardo o quei ladri alla Taverna del Canto Elfico. Oppure ancora, potremmo semplicemente tornare al palazzo.~
//based on SoD @60957
@1000045 = ~Dimmelo tu. Dobbiamo acquistare equipaggiamento e trovare alleati per il viaggio a nord. C'è quel bardo o quei ladri alla Taverna del Canto Elfico oppure un monaco al palazzo del Trono di Ferro. Oppure ancora, potremmo semplicemente tornare al palazzo.~
//based on SoD @60957
@1000046 = ~Dimmelo tu. Dobbiamo acquistare equipaggiamento e trovare alleati per il viaggio a nord. C'è quel bardo o quei ladri alla Taverna del Canto Elfico. Oppure ancora, potremmo semplicemente tornare al palazzo.~
//based on BG1 @180, just remove sentence regarding Iron shortage
@1000047 = ~Ahhh, con questo guscio potrò fabbricare un'ottima armatura di piastre per un governatore o per qualcuno più in alto. I nobili amano i materiali esotici e non si preoccupano del prezzo. Probabilmente, quando avrò finito, guadagnerò circa 20.000 monete d'oro per una decade di lavoro.~
//based on BG1 @15763, just remove sentence regarding Iron shortage
@1000048 = ~Una buona giornata a te! Potrebbero interessarti i miei gingilli?~
//based on BG1 @3629, just remove sentence regarding Iron shortage
@1000049 = ~Ehi, sembri un tipo avventuroso. Hai bisogno di equipaggiamento nuovo?~ ~Ehi, sembri una tipa avventurosa. Hai bisogno di equipaggiamento nuovo?~
//based on BG1 @15769, just remove sentence regarding Iron shortage
@1000050 = ~Ti stai godendo la fiera? Che cosa posso offrirti?~
