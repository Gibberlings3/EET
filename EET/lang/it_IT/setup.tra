//setup-EET
@900000 = ~EET core (importazione delle risorse)~
@900001 = ~Installa questo componente sul motore di BG2:EE~
@900002 = ~EET deve essere installato PRIMA di BP-BGT Worldmap~
@900003 = ~Directory di BG:EE rilevata: %bgee_dir%.
Confermi? [Y] Si o [N] No~
@900004 = ~Inserisci il percorso completo dell'installazione di BG:EE+SoD e premi Invio.
Esempio: C:\Program Files (x86)\BeamDog\Games\00806~
@900005 = ~Directory non valida o installazione di BG:EE+SoD non corretta.
Puoi interrompere in sicurezza l'installazione chiudendo questa finestra o premendo Ctrl+C.~
@900006 = ~Hai installato il componente errato di The Stone of Askavar. EET supporta la versione Default (opzione 1 durante l'installazione).~
@900007 = ~Hai installato il componente errato di Drizzt Saga. EET supporta la versione Default (opzione 1 durante l'installazione).~
@900008 = ~Il mod %col1% per BG:EE non risulta riconosciuto da EET e quindi non puo essere importato in BG2:EE con EET~
@900009 = ~Questo componente richiede che il componente di inizializzazione di EET sia installato per primo~

@900100 = ~Crea collegamento sul desktop~
@900101 = ~Saltato tramite argomento WeiDU~
@900102 = ~Non disponibile per questo sistema~

//setup-EET_end
@910000 = ~EET end (ultimo mod nell'ordine di installazione)~
@910001 = ~Questo componente richiede che EET core sia installato per primo~
@910002 = ~Installazione standard~
@910003 = ~Aggiorna anche i salvataggi (nessun backup; consulta il file readme)~

//setup-EET_GUI
@920000 = ~Siege of Dragonspear~
@920001 = ~GUI alternativa di EET~
@920002 = ~Icewind Dale: Enhanced Edition~
@920003 = ~Questo componente richiede EET~
