BEGIN
  ACTION_IF (FILE_EXISTS ~%TEMP_FOLDER%/2da/%file%.2da~) BEGIN
    COPY_LARGE + ~%TEMP_FOLDER%/2da/%file%.2da~ ~%TEMP_FOLDER%/array~
    DELETE + ~%TEMP_FOLDER%/2da/%file%.2da~
  END
END

